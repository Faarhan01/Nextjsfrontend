PORT=3000
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
GEMINI_API_KEY=

# MedusaJS Store API
# Leave blank to use the local Express backend (same origin at /api).
# Set to a remote Medusa URL to connect an external Medusa backend instead.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=

# Optional: payments/email
# STRIPE_SECRET_KEY=...
# STRIPE_WEBHOOKS_SIGNING_SECRET=...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=...
# RESEND_API_KEY=...
